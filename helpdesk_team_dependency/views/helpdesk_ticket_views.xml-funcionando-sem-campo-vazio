<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Herda a view de ticket do helpdesk_mgmt -->
    <record id="view_helpdesk_ticket_form_inherit_dependency" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.dependency</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Adiciona campo dependency_team_id -->
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="dependency_team_id" placeholder="No team selected"/>
            </xpath>

            <!-- Adiciona aba de histórico -->
            <xpath expr="//notebook" position="inside">
                <page string="Dependency History" name="page_dependency_history">
                    <field name="dependency_history_ids" readonly="1" create="0" delete="0">
                        <tree>
                            <field name="team_id" string="Team"/>
                            <field name="change_date" string="Change Date"/>
                            <field name="duration" string="Duration"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
